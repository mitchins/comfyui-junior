# Public Service Binding
HOST=0.0.0.0
PORT=8000

# Internal ComfyUI Backend
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
COMFY_MEMORY_CAP_GIB=10.0

# Storage Directories
MODEL_DIR=/models
DATA_DIR=/data

# Safety Classifier Configuration (Default: local mounted volume at /models/safety/v7_distilbert)
SAFETY_ENABLED=1
SAFETY_DEVICE=cuda:0
SAFETY_MODEL_PATH=/models/safety/v7_distilbert
