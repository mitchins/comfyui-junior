# ==============================================================================
# ComfyUI Junior - Environment Configuration
# ==============================================================================

# Public Service Binding
HOST=0.0.0.0
PORT=8000

# Internal ComfyUI Backend
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
# Allocator ceiling in GiB for the ComfyUI process. 0 disables the ceiling.
# Per-stack qualified defaults apply when unset: 10.0 (blackwell_nvfp4),
# none (ampere_fp8 - measured to fit a 12 GB card with the API-side size clamp).
# COMFY_MEMORY_CAP_GIB=0.0

# Image Generation Stack
# auto (default) | blackwell_nvfp4 (SM120) | ampere_fp8 (SM86+)
# JUNIOR_IMAGE_STACK=auto

# Storage Directories
MODEL_DIR=/models
DATA_DIR=/data

# Safety Classifier (unconditional in appliance mode; FP16 on CUDA is enforced)
SAFETY_DEVICE=cuda:0
SAFETY_MODEL_PATH=/models/safety/v29db
# Optional pinned-source override (requires an immutable 40-char commit SHA):
# SAFETY_HF_REPO=Mitchins/comfyui-junior-safety
# SAFETY_HF_REVISION=a377d25017065db0ec5b8a7b6a2d11a30a906d5b

# Language envelope model (fastText lid.176)
# LID176_PATH=/models/safety/lid.176.bin

# Owner-Operated Evaluation Instance
# DANGER: setting this to 1 disables ALL prompt filtering on this instance and
# disables the child frontend. It exists so the owner can measure the raw
# model externally (e.g. gauging safety false positives/negatives). Never
# expose such an instance as the children's appliance.
# JUNIOR_EVALUATION_INSTANCE=0

# Hugging Face Access (Optional for public model assets)
# HF_TOKEN=hf_...
